{
  "manifest_version": 3,
  "name": "Account Switcher for Google",
  "version": "0.1.0",
  "description": "Opens the account list on the Google top page, so switching accounts takes one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "account-switcher-for-google@piro0919",
      "update_url": "https://account-switcher-for-google.kkweb.io/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/",
        "https://www.google.com/?*",
        "https://www.google.co.jp/",
        "https://www.google.co.jp/?*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ogs.google.com/*/widget/account*"
      ],
      "js": [
        "popup-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
